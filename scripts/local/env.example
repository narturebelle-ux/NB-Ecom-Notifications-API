# Copy this file to .env in the repo root (it's gitignored) and fill in your values.
# Never commit .env or paste its values anywhere.

# A Resend API key with "Sending access" for mail.narturebelle.com. Create a separate one named
# notifications-local. Leave it empty to run log-only: nothing is sent, the log says what would have been.
RESEND_API_KEY=

# Any value. The test script reads it from here, so you don't need to change it.
INTERNAL_API_TOKEN=local-dev-token

# Recommended locally: the local website signs everyone in as dev@localhost, which can't receive email,
# so send every email to one real inbox instead. Ignored in prod.
EMAIL_REDIRECT_TO=hello@narturebelle.com

# Emails sent to a userId ask the Care API for the address.
CARE_API_URL=http://localhost:8085
